{
  "manifest_version": 3,
  "name": "BibleDesk Companion",
  "version": "1.0.0",
  "description": "Instant Scripture lookup, 5-dimension AI Bible study, Strong's lexicon, and cross-references right from any webpage.",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.bibledesk.app/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Open BibleDesk Companion"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
