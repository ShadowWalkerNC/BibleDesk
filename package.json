{
  "name": "bibledesk",
  "version": "1.0.0",
  "description": "Bible-first study platform with optional 5-dimension AI assistant",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "node --test tests/security-boundaries.test.mjs packages/sdk/test/sdk.test.mjs && tsx --test tests/evidence.test.ts tests/db.test.ts tests/api.test.ts tests/critical-path.test.ts",
    "test:unit": "tsx --test tests/evidence.test.ts tests/db.test.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:e2e": "tsx --test tests/critical-path.test.ts",
    "test:security": "node --test tests/security-boundaries.test.mjs",
    "test:sdk": "node --test packages/sdk/test/sdk.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "check:env": "node scripts/doctor.mjs",
    "db:bundle": "node scripts/build-schema-init.mjs",
    "sdk:build": "npm --prefix packages/sdk run build",
    "build:web": "next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.12.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.5",
    "openai": "^4.100.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
