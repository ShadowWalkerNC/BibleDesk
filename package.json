{
  "name": "bibledesk",
  "version": "1.0.0",
  "description": "Bible-first study platform with optional 5-dimension AI assistant",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "package:all": "echo \"Native packaging (Android, desktop, extension) is parked for MVP - see archive/*/PARKED.md\" && exit 1",
    "build:web": "node scripts/build-all-packages.mjs --target=web",
    "build:desktop": "echo \"Desktop packaging is parked for MVP - see archive/desktop/PARKED.md\" && exit 1",
    "build:android": "echo \"Android packaging is parked for MVP - see archive/android/PARKED.md\" && exit 1",
    "build:extension": "echo \"Extension packaging is parked for MVP - see archive/extension/PARKED.md\" && exit 1",
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:dist": "npm --prefix apps/desktop run dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@google/genai": "^2.12.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^1.33.0",
    "next": "16.2.9",
    "openai": "^4.100.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5"
  }
}
