# BibleDesk environment variables
# Copy to .env.local for local dev — add the same keys in Vercel / Render project settings.
# Never commit .env.local to git.

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# Required for AI answer generation (pipeline stages + /api/ask)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI (RAG embeddings) ────────────────────────────────────────────────
# Required for RAG: 1536-dim embeddings via text-embedding-3-small
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (Bible reader study companion) ───────────────────────────
# Optional. Powers POST /api/bible/study (Strong's/commentary assistant).
# Without it, the route returns an offline fallback stub.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Supabase ───────────────────────────────────────────────────────────────
# Public URL + anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Knowledge graph ────────────────────────────────────────────────────────
# Protects POST /api/graph and GET /api/export/obsidian
# Generate with: openssl rand -hex 32
GRAPH_WRITE_SECRET=

# ── Rate limiting ──────────────────────────────────────────────────────────
# Salt for SHA-256 IP hashing (never store raw IPs)
# Generate with: openssl rand -hex 16
IP_HASH_SALT=

# ── App URL ────────────────────────────────────────────────────────────────
# Set to your production URL once deployed (e.g. https://bibledesk.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (private Prayer Care exports) ──────────────────────────────
# Create a Google OAuth Web application and register this exact callback:
#   ${NEXT_PUBLIC_APP_URL}/api/google/callback
# Enable Google Calendar API and Gmail API. These values are server-only except
# NEXT_PUBLIC_APP_URL. BibleDesk requests calendar.events + gmail.compose and
# creates Gmail drafts only; it never sends mail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte AES-256 key, encoded as 64 hex characters (or base64).
# Generate hex with: openssl rand -hex 32
# Rotating this key requires users to reconnect Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Sigil / Discord webhook ────────────────────────────────────────────────
# HMAC secret shared with the Sigil Discord bot (x-bibledesk-signature)
# Generate with: openssl rand -hex 32
BIBLEDESK_WEBHOOK_SECRET=

# Optional Discord incoming webhooks for church tools
PRAYER_DISCORD_WEBHOOK_URL=
SIGIL_PRAYER_WEBHOOK_URL=
SIGIL_SERMON_WEBHOOK_URL=

# ── MCP HTTP server ────────────────────────────────────────────────────────
# Optional. If set, POST /api/mcp requires: Authorization: Bearer <MCP_SECRET>
# If unset, the endpoint is open (dev / internal use only).
# Generate with: openssl rand -hex 32
MCP_SECRET=
