# BibleDesk environment variables
# Copy to .env.local for local dev — add the same keys in Railway project settings.
# Never commit .env.local to git.

# ── Database (Railway PostgreSQL) ──────────────────────────────────────────────
# Required. Provided automatically by Railway when you attach a PostgreSQL service.
# For local dev: postgresql://postgres:password@localhost:5432/bibledesk
DATABASE_URL=

# ── Authentication (JWT) ───────────────────────────────────────────────────────
# Required for stateless JWT auth (Bearer tokens issued at login).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# NEXTAUTH_SECRET is also accepted as a fallback if JWT_SECRET is unset.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# ── Anthropic (Claude) ─────────────────────────────────────────────────────────
# Required for AI answer generation (pipeline stages + /api/ask)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI (RAG embeddings) ────────────────────────────────────────────────────
# Required for RAG: 1536-dim embeddings via text-embedding-3-small
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (Bible reader study companion) ───────────────────────────────
# Optional. Powers POST /api/bible/study (Strong's/commentary assistant).
# Without it, the route returns an offline fallback stub.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Knowledge graph ────────────────────────────────────────────────────────────
# Protects POST /api/graph and GET /api/export/obsidian
# Generate with: openssl rand -hex 32
GRAPH_WRITE_SECRET=

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Salt for SHA-256 IP hashing (never store raw IPs)
# Generate with: openssl rand -hex 16
IP_HASH_SALT=

# ── App URL ────────────────────────────────────────────────────────────────────
# Set to your production URL once deployed (e.g. https://bibledesk.up.railway.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (private Prayer Care exports) ─────────────────────────────────
# Register ${NEXT_PUBLIC_APP_URL}/api/google/callback in a Google OAuth web app.
# Enable Calendar and Gmail APIs. Gmail access creates drafts only; BibleDesk
# never sends mail automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte AES-256 key encoded as 64 hex characters or base64.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Sigil webhook ──────────────────────────────────────────────────────────────
# HMAC secret for the Sigil webhook (x-bibledesk-signature)
# Generate with: openssl rand -hex 32
BIBLEDESK_WEBHOOK_SECRET=

SIGIL_PRAYER_WEBHOOK_URL=

# ── MCP HTTP server ────────────────────────────────────────────────────────────
# REQUIRED in production. POST /api/mcp requires: Authorization: Bearer <MCP_SECRET>
# If unset, the endpoint refuses ALL requests with 401 (fail-closed — no dev-mode bypass).
# Generate with: openssl rand -hex 32
MCP_SECRET=

# ── Stripe billing (optional) ─────────────────────────────────────────────────
# If unset, billing runs in mock/self-hosted mode (no charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
